msgid "Deferred Email Delay"
msgstr ""

#: admin/configure.php:109
msgid "minutes"
msgstr ""

#: admin/configure.php:111
msgid ""
"Wait this many minutes after the last unread message in thread before "
"sending notification email. Default: 5 minutes."
msgstr ""

