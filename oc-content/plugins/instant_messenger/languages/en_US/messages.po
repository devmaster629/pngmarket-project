msgid ""
"When enabled, messages in thread are refreshed without need of reload page."
msgstr ""

#: admin/configure.php:165
msgid "Ajax refresh frequency"
msgstr ""

#: admin/configure.php:167
msgid "miliseconds"
msgstr ""

#: admin/configure.php:169
msgid ""
"Frequency of message refresh using ajax, not recommended to go under 1000 "
"miliseconds, ideal should be 3000 - 6000 miliseconds (once per 3-6 seconds)."
msgstr ""

#: admin/configure.php:173
msgid "User can Remove Thread"
msgstr ""

#: admin/configure.php:176
msgid ""
"When enabled, users can remove their threads. Thread is initially removed "
"only from account of user that wants to remove it. If also second user wants "
"to remove thread, it is completely removed from site."
msgstr ""

#: admin/configure.php:180
msgid "Add Button to Header"
msgstr ""

#: admin/configure.php:183
msgid ""
"When enabled, \"Messenger\" button/link is added into header. Require "
"Osclass 8.2 theme hooks support."
msgstr ""

#: admin/configure.php:188
msgid "One Thread Per User"
msgstr ""

#: admin/configure.php:190
msgid ""
"Only one conversation between two registered users. Reuses existing thread. "
"Item contact for registered sellers uses user route."
msgstr ""

#: admin/configure.php:194
msgid "Contact item seller — button hooks"
msgstr ""

#: admin/configure.php:197
msgid ""
"Osclass hooks where the contact seller button is output (listing / item "
"pages). Comma-separated hook names."
msgstr ""

#: admin/configure.php:198
msgid ""
"Uses im_contact_button: recipient is the seller of the current item (item "
"ID). Not for public profile pages."
msgstr ""

#: admin/configure.php:199
msgid "Default: item_contact"
msgstr ""

#: admin/configure.php:204
msgid "Contact user — button hooks"
msgstr ""

#: admin/configure.php:207
msgid ""
"Osclass hooks where the contact user button is output (public user profile). "
"Comma-separated hook names."
msgstr ""

#: admin/configure.php:208
msgid ""
"Uses im_contact_user_button: recipient is resolved from the profile user ID "
"(public profile). Not tied to a listing."
msgstr ""

#: admin/configure.php:209
msgid "Default: user_public_profile_sidebar_bottom"
msgstr ""

