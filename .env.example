# Osclass environment config (example)
# Copy this file to .env and fill in real values:
#   copy .env.example .env

# MySQL — local defaults
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=osclass
DB_TABLE_PREFIX=oc_

# Site URLs — use the URL you actually open in the browser
REL_WEB_URL=/
WEB_PATH=http://localhost:8000/

# Optional debugging (local)
# OSC_DEBUG=true
# OSC_DEBUG_DB=true
# OSC_DEBUG_LOG=true

# Facebook Instant Login (facebook_js_login plugin)
# Create an app at https://developers.facebook.com/ and add your site URL
# under Facebook Login → Settings → Valid OAuth Redirect URIs.
# FB_APP_ID=
# FB_APP_SECRET=
